# Autenticação & Sessão
JWT_SECRET=
NODE_ENV=development

# Supabase (Instância Principal)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_AUTH_EMAIL=
# SUPABASE_AUTH_PASSWORD=

# Firebase Admin (financeiro: somente no servidor)
FIREBASE_DATABASE_URL=https://trafegopro-5206e-default-rtdb.firebaseio.com
# FIREBASE_SERVICE_ACCOUNT_JSON= (JSON completo da conta de serviço; nunca usar VITE_)
# Ou configure GOOGLE_APPLICATION_CREDENTIALS com o caminho do arquivo de serviço.

# Persistência MySQL obrigatória em produção para formulários, feedbacks e tokens externos
DATABASE_URL=

# Meta Ads & Graph API
META_APP_ID=
META_APP_SECRET=
META_ADS_VALIDATION_TOKEN=
META_BUSINESS_LOGIN_CONFIG_ID=
META_DIRECT_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Social Publishing
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Evolution API / WhatsApp CRM
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_SUPABASE_URL=
EVOLUTION_SUPABASE_SERVICE_ROLE_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_PUBLIC_URL=
PUBLIC_APP_URL=http://localhost:5173

# Classificação ao vivo do CRM (Laya, self-hosted na VPS — sem OpenAI)
LAYA_SERVICE_URL=
LAYA_SERVICE_SECRET=
# Laya no Pixel (mesmo modelo do SDR Flow): classifica em intervalo fixo os leads que
# receberam mensagem desde a última varredura (não a cada mensagem)
LAYA_CLASSIFY_INTERVAL_MINUTES=15
LAYA_TIMEOUT_MS=45000
# Score de interesse (0–4) abaixo do qual o lead vai para "perdido"
LAYA_LOST_INTEREST_THRESHOLD=0.8
EVOLUTION_AI_LIVE_FLUSH_INTERVAL_MINUTES=15

# Alerta de instância desconectada (push no celular via ntfy próprio na VPS).
# Sem NTFY_URL/NTFY_TOPIC o monitor fica desligado. NTFY_TOKEN é de um usuário write-only.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
EVOLUTION_ALERT_DOWN_MINUTES=5
EVOLUTION_ALERT_REMINDER_HOURS=24
# Instâncias fora do painel para vigiar também (separadas por vírgula)
EVOLUTION_ALERT_EXTRA_INSTANCES=
# true = vigia todas as instâncias da Evolution (inclusive sdr-flow), não só as do painel
EVOLUTION_ALERT_ALL_INSTANCES=false

# Frontend Forge
VITE_FRONTEND_FORGE_API_URL=
