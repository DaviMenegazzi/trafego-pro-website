# /etc/cron.d/trafego-pro — rotinas agendadas do site (antes feitas pelo Manus)
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Publicações sociais agendadas: a cada 5 minutos
*/5 * * * * root /usr/local/bin/trafego-cron.sh social-publish

# Desligadas até decisão: nunca rodaram no Manus (mudariam o comportamento do CRM).
# Classificação diária dos leads por IA (03:00 — a VPS está no fuso de Brasília)
#0 3 * * * root /usr/local/bin/trafego-cron.sh evolution-ai-daily
# Limpeza da quarentena (> 48h sem evidência de anúncio) (03:30)
#30 3 * * * root /usr/local/bin/trafego-cron.sh evolution-quarantine-cleanup
